# Copia este archivo a ".env" en la raíz del repo y rellena los valores.
# Nunca subas ".env" a git (ya está en .gitignore).

# URL base de tu Jira Cloud (sin barra final)
JIRA_BASE_URL=https://transportesanchez-tesis.atlassian.net

# Email de la cuenta de Atlassian asociada al token
JIRA_EMAIL=tu-email@ejemplo.com

# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Clave del proyecto (ej. TS, SCRUM) — la ves en la URL al abrir un tablero
JIRA_PROJECT_KEY=

# Nombre del tipo de issue por defecto (Task, Story, Bug, etc.)
JIRA_ISSUE_TYPE=Task
